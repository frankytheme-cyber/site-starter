---
/**
 * Effetti di sfondo delle sezioni (src/themes/backgrounds.ts): per ognuno scheda, blocchi che lo
 * ammettono e la cta di _backgrounds.ts sui tre toni, con i selettori di palette, font e forma.
 */
import { TONES } from '@/core/block-types';
import { blocks } from '@/core/registry';
import SectionFrame from '@/core/SectionFrame.astro';
import Container from '@/core/ui/Container.astro';
import { allowedBackgrounds, BACKGROUND_META, BACKGROUNDS } from '@/themes/backgrounds';
import { EDGE_META } from '@/themes/edges';
import { backgroundSample, EDGE_SAMPLE } from './_backgrounds';
import CatalogLayout from './_CatalogLayout.astro';
import { catalogTitle } from './_library';

const { Component, fixture } = backgroundSample();
const pageBlocks = blocks.filter((block) => block.meta.scope === 'page');
const effects = BACKGROUNDS.map((key) => ({
	key,
	...BACKGROUND_META[key],
	blocks: pageBlocks.filter((block) => allowedBackgrounds(block.meta).includes(key)).map((block) => block.type),
}));
---

<CatalogLayout title={catalogTitle('Sfondi')}>
	<main>
		<Container>
			<div class="py-10">
				<h1 class="text-3xl font-bold">Effetti di sfondo</h1>
				<p class="mt-3 max-w-3xl text-lg">
					Accanto a <code>tone</code>, ogni sezione può avere <code>background</code>: un effetto sopra il colore del tono,
					con i colori della palette. Il valore di partenza è <code>pieno</code>; gli altri vanno su poche sezioni, al
					massimo 3 per pagina e mai due vicine. Il contrasto dei testi è verificato su ogni palette e tono.
				</p>
				<nav aria-label="Effetti" class="mt-4">
					<ul class="flex flex-wrap gap-x-6 gap-y-2">
						{
							effects.map((effect) => (
								<li>
									<a href={`#sfondo-${effect.key}`} class="text-primary underline underline-offset-4">
										{effect.name}
									</a>
								</li>
							))
						}
						<li>
							<a href="#bordi" class="text-primary underline underline-offset-4">Bordi</a>
						</li>
					</ul>
				</nav>
			</div>
		</Container>

		{
			effects.map((effect) => (
				<article id={`sfondo-${effect.key}`} class="scroll-mt-20 border-t-4 border-border">
					<Container>
						<div class="py-8">
							<h2 class="text-2xl font-bold">
								{effect.name} <code class="text-base font-normal">"background": "{effect.key}"</code>
							</h2>
							<p class="mt-2 max-w-3xl">{effect.description}</p>
							{effect.key === 'decoro' && (
								<p class="mt-2 max-w-3xl text-fg-muted">Scegli il decoro nella barra in alto: con «nessuno» le sezioni restano piene.</p>
							)}
							<dl class="mt-4 grid gap-4 md:grid-cols-2">
								<div>
									<dt class="font-semibold">Quando usarlo</dt>
									<dd class="mt-1 text-fg-muted">{effect.whenToUse}</dd>
								</div>
								<div>
									<dt class="font-semibold">Blocchi</dt>
									<dd class="mt-1 text-fg-muted">{effect.blocks.join(', ')}</dd>
								</div>
							</dl>
							<a href={`/catalogo/sfondi/${effect.key}/`} class="mt-4 inline-block text-sm text-primary underline underline-offset-4">
								Da solo
							</a>
						</div>
					</Container>
					{TONES.map((tone) => (
						<SectionFrame background={effect.key}>
							<Component {...fixture.props} tone={tone} site={fixture.site} />
						</SectionFrame>
					))}
				</article>
			))
		}

		<article id="bordi" class="scroll-mt-20 border-t-4 border-border">
			<Container>
				<div class="py-8">
					<h2 class="text-2xl font-bold">Bordi tra sezioni <code class="text-base font-normal">"edge"</code></h2>
					<p class="mt-2 max-w-3xl">
						Il bordo in alto di una sezione prende una forma nel suo colore e copre il fondo della sezione precedente. Si vede
						solo dopo una sezione di tone diverso; al massimo 2 per pagina, mai sulla prima.
					</p>
					<dl class="mt-4 grid gap-4 md:grid-cols-3">
						{
							EDGE_SAMPLE.filter(({ edge }) => edge !== 'dritto').map(({ edge }) => (
								<div>
									<dt class="font-semibold">
										{EDGE_META[edge].name} <code class="font-normal">"{edge}"</code>
									</dt>
									<dd class="mt-1 text-fg-muted">{EDGE_META[edge].whenToUse}</dd>
								</div>
							))
						}
					</dl>
					<a href="/catalogo/sfondi/bordi/" class="mt-4 inline-block text-sm text-primary underline underline-offset-4">Da soli</a>
				</div>
			</Container>
			{
				EDGE_SAMPLE.map(({ tone, edge }) => (
					<SectionFrame edge={edge}>
						<Component {...fixture.props} tone={tone} site={fixture.site} />
					</SectionFrame>
				))
			}
		</article>
	</main>
</CatalogLayout>
