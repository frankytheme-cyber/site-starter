{
  "name": "site-starter",
  "description": "site-starter — libreria di blocchi per siti vetrina",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run gen:decap",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/checks/run.ts --suite=check",
    "qa": "node scripts/checks/run.ts --suite=qa",
    "check:contrast": "node scripts/checks/run.ts contrast",
    "check:recipes": "node scripts/checks/run.ts recipes",
    "check:decap": "node scripts/checks/run.ts decap",
    "check:tokens": "node scripts/checks/run.ts tokens",
    "check:blocks": "node scripts/checks/run.ts blocks",
    "check:lock": "node scripts/checks/run.ts lock",
    "check:catalog": "node scripts/checks/run.ts blocks",
    "gen:decap": "node scripts/gen-decap-config.ts",
    "gen:catalog": "node scripts/gen-catalog.ts",
    "screenshots": "node scripts/screenshots.ts",
    "catalog": "npm run gen:catalog && npm run screenshots",
    "release": "node scripts/release.ts",
    "site:init": "node scripts/site-init.ts",
    "blocks:sync": "node scripts/blocks-sync.ts",
    "check:template": "node scripts/template-as-site.ts",
    "cms:local": "node scripts/cms-local.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/simple-icons": "^1.2.100",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "decap-cms": "^3.17.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.5",
    "decap-server": "^3.11.5",
    "lighthouse": "^13.5.0",
    "linkinator": "^8.1.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
