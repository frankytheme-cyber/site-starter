---
import sala from '@/assets/images/fixtures/ristorante-sala.jpg';
import scrivania from '@/assets/images/fixtures/studio-scrivania.jpg';
import Accordion from '@/core/ui/Accordion.astro';
import AccordionItem from '@/core/ui/AccordionItem.astro';
import Carousel from '@/core/ui/Carousel.astro';
import CarouselSlide from '@/core/ui/CarouselSlide.astro';
import Container from '@/core/ui/Container.astro';
import Img from '@/core/ui/Img.astro';
import Section from '@/core/ui/Section.astro';
import Tabs from '@/core/ui/Tabs.astro';
import CatalogLayout from './_CatalogLayout.astro';
import { catalogTitle } from './_library';

const slides = Array.from({ length: 6 }, (_, index) => ({
	title: `Foto ${index + 1}`,
	image: index % 2 === 0 ? sala : scrivania,
	alt: index % 2 === 0 ? 'Sala di un ristorante con tavoli apparecchiati' : 'Scrivania con computer portatile e una pianta',
}));
---

<CatalogLayout title={catalogTitle('Primitive UI')}>
	<main>
		<Container>
			<div class="py-10">
				<h1 class="text-3xl font-bold">Primitive UI</h1>
				<p class="mt-3 max-w-3xl text-fg-muted">
					I componenti di <code>src/core/ui</code> con cui sono fatti i blocchi, in tutti gli stati. Il focus si vede
					spostandosi con Tab; le regole dei componenti interattivi sono in <code>docs/blocchi-interattivi.md</code>.
					I pulsanti hanno una pagina loro: <a href="/catalogo/bottoni/" class="text-primary underline underline-offset-4">Bottoni</a>.
				</p>
			</div>
		</Container>

		<Section tone="muted">
			<h2 class="text-2xl font-bold">Accordion</h2>
			<div class="mt-6 grid gap-10 lg:grid-cols-2">
				<div>
					<h3 class="mb-2 font-semibold">Più voci aperte</h3>
					<Accordion>
						<AccordionItem title="Aperta al caricamento" open>
							<p class="text-fg-muted">Il contenuto entra con una breve dissolvenza, se il movimento non è ridotto.</p>
						</AccordionItem>
						<AccordionItem title="Seconda voce">
							<p class="text-fg-muted">Si apre e chiude con Invio o Spazio sul titolo.</p>
						</AccordionItem>
						<AccordionItem title="Terza voce">
							<p class="text-fg-muted">Senza JS funziona lo stesso: è un elemento details.</p>
						</AccordionItem>
					</Accordion>
				</div>
				<div>
					<h3 class="mb-2 font-semibold">Una alla volta (single)</h3>
					<Accordion single>
						<AccordionItem title="Prima voce" open>
							<p class="text-fg-muted">Aprendo un'altra voce, questa si chiude.</p>
						</AccordionItem>
						<AccordionItem title="Seconda voce">
							<p class="text-fg-muted">Con JS ne resta aperta una sola.</p>
						</AccordionItem>
						<AccordionItem title="Terza voce">
							<p class="text-fg-muted">Senza JS restano apribili tutte.</p>
						</AccordionItem>
					</Accordion>
				</div>
			</div>
		</Section>

		<Section tone="default">
			<h2 class="text-2xl font-bold">Tabs</h2>
			<p class="mt-2 max-w-3xl text-fg-muted">
				Frecce, Home e End tra le schede; sotto 768 px diventa un Accordion. Senza JS, pannelli in sequenza con il titolo.
			</p>
			<Tabs label="Esempio di schede" tabs={['Prima', 'Seconda', 'Terza']} class="mt-6">
				<Fragment slot="panel-0"><p class="text-fg-muted">Contenuto della prima scheda.</p></Fragment>
				<Fragment slot="panel-1"><p class="text-fg-muted">Contenuto della seconda scheda.</p></Fragment>
				<Fragment slot="panel-2"><p class="text-fg-muted">Contenuto della terza scheda.</p></Fragment>
			</Tabs>
		</Section>

		<Section tone="muted">
			<h2 class="text-2xl font-bold">Carousel</h2>
			<p class="mt-2 max-w-3xl text-fg-muted">
				Scroll-snap e swipe nativo; frecce e pallini con JS, pallino attivo con aria-current. Niente autoplay.
			</p>
			<Carousel label="Esempio di carosello" class="mt-6">
				{
					slides.map((slide) => (
						<CarouselSlide width="card">
							<figure class="overflow-hidden rounded-box bg-bg">
								<Img src={slide.image} alt={slide.alt} sizes="352px" class="aspect-3/2 w-full object-cover" />
								<figcaption class="p-4 font-semibold">{slide.title}</figcaption>
							</figure>
						</CarouselSlide>
					))
				}
			</Carousel>
		</Section>
	</main>
</CatalogLayout>
