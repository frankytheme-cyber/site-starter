---
/**
 * Una pagina per ricetta in src/content/pages: index.json → "/", servizi.json → "/servizi/".
 * Le bozze (draft: true) si vedono in sviluppo e nelle anteprime, non nella produzione su Vercel.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import { assertSpecialHrefs } from '@/core/links';
import RenderSections from '@/core/RenderSections.astro';
import { getSiteSettings } from '@/core/settings';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
	const hideDrafts = import.meta.env.PROD && process.env.VERCEL_ENV === 'production';
	const pages = await getCollection('pages', ({ data }) => !(hideDrafts && data.draft));
	return pages.map((page) => ({
		params: { slug: page.id === 'index' ? undefined : page.id },
		props: { page },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const { title, description, draft, ogImage, noindex, sections } = page.data;

// Prima di disegnare: un @whatsapp senza numero in site.json si legge con sezione e campo.
assertSpecialHrefs(`pagina ${page.id}.json`, page.data, await getSiteSettings());
---

{/* Header e footer li mette BaseLayout da layout.json: le sezioni della ricetta sono il contenuto di <main>. */}
<BaseLayout title={title} description={description} ogImage={ogImage} noindex={noindex || draft}>
	<RenderSections sections={sections} />
</BaseLayout>
