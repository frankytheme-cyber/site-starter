---
/**
 * Un effetto di sfondo da solo, sui tre toni (default, muted, primary): la cta banner di
 * _backgrounds.ts, senza la barra del catalogo né header e footer del sito. La usano gli screenshot
 * (npm run screenshots). Il tema si cambia con ?palette=&fonts=&shape=&pattern=&texture= (valori di presets.ts).
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { TONES } from '@/core/block-types';
import SectionBackground from '@/core/SectionBackground.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BACKGROUND_META, BACKGROUNDS } from '@/themes/backgrounds';
import { fonts, palettes, patterns, shapes, textures } from '@/themes/presets';
import { backgroundSample } from '../_backgrounds';
import { catalogTitle, LIBRARY_DESCRIPTION } from '../_library';

export const getStaticPaths = (() => BACKGROUNDS.map((background) => ({ params: { background }, props: { background } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { background } = Astro.props;
const { name } = BACKGROUND_META[background];
const { Component, fixture } = backgroundSample();
const presets = { palette: palettes, fonts, shape: shapes, pattern: patterns, texture: textures };
---

<BaseLayout title={catalogTitle(`Sfondo ${name}`)} description={LIBRARY_DESCRIPTION} noindex allFonts siteLayout={false}>
	{/* Prima delle sezioni, così non si vede il cambio di tema: solo valori ammessi dai preset. */}
	<script is:inline define:vars={{ presets }}>
		const params = new URLSearchParams(location.search);
		for (const [key, values] of Object.entries(presets)) {
			const value = params.get(key);
			if (value && values.includes(value)) document.documentElement.dataset[key] = value;
		}
	</script>
	<main data-catalog-background={background}>
		<h1 class="sr-only">Effetto di sfondo {name} sui toni default, muted e primary</h1>
		{
			TONES.map((tone) => (
				<SectionBackground background={background}>
					<Component {...fixture.props} tone={tone} site={fixture.site} />
				</SectionBackground>
			))
		}
	</main>
</BaseLayout>
