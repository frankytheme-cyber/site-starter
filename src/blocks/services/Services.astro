---
import Button from '@/core/ui/Button.astro';
import Icon from '@/core/ui/Icon.astro';
import Img from '@/core/ui/Img.astro';
import Section from '@/core/ui/Section.astro';
import type { ServicesProps } from './schema';

type Props = ServicesProps;

const { id, tone, variant, eyebrow, title, intro, items } = Astro.props;

const isAlternato = variant === 'alternato';

// 2 e 4 card stanno su due colonne, 3, 5 e 6 su tre: niente card sole sull'ultima riga di una griglia da 2×2.
const twoColumns = items.length === 2 || items.length === 4;
// Larghezza di una card: a lg il Container lascia 1088px, tolti i gap-8 tra le colonne.
const cardSizes = twoColumns
	? '(min-width: 1152px) 528px, (min-width: 640px) 46vw, 100vw'
	: '(min-width: 1152px) 341px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw';
---

<Section id={id} tone={tone}>
	<div class="mx-auto max-w-2xl text-center">
		{eyebrow && <p class="mb-4 text-sm font-semibold tracking-wider text-primary uppercase">{eyebrow}</p>}
		<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h2>
		{intro && <p class="mt-4 text-lg text-pretty text-fg-muted">{intro}</p>}
	</div>

	{
		isAlternato ? (
			<ul class="mt-16 grid gap-16 lg:gap-24">
				{items.map((item, index) => (
					<li class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
						{item.image && (
							<Img
								src={item.image.src}
								alt={item.image.alt}
								sizes="(min-width: 1152px) 512px, (min-width: 1024px) 45vw, 100vw"
								class:list={['aspect-4/3 w-full rounded-box object-cover', index % 2 === 1 && 'lg:order-last']}
							/>
						)}
						<div>
							<h3 class="text-2xl font-bold tracking-tight">{item.title}</h3>
							<p class="mt-3 text-lg text-pretty text-fg-muted">{item.text}</p>
							{item.link && (
								<p class="mt-6">
									<Button href={item.link.href} variant="link">
										{item.link.label}
										<Icon name="freccia-destra" size="sm" />
									</Button>
								</p>
							)}
						</div>
					</li>
				))}
			</ul>
		) : (
			<ul class:list={['mt-12 grid gap-8 sm:grid-cols-2', !twoColumns && 'lg:grid-cols-3']}>
				{items.map((item) => (
					<li class="flex flex-col overflow-hidden rounded-box bg-surface text-surface-fg">
						{variant === 'cards-immagine' && item.image && (
							<Img
								src={item.image.src}
								alt={item.image.alt}
								sizes={cardSizes}
								class="aspect-3/2 w-full object-cover"
							/>
						)}
						<div class="flex flex-1 flex-col p-6">
							{variant === 'cards-icone' && item.icon && (
								<span class="mb-5 flex size-12 items-center justify-center rounded-button bg-primary text-primary-fg">
									<Icon name={item.icon} size="lg" />
								</span>
							)}
							<h3 class="text-xl font-bold tracking-tight">{item.title}</h3>
							<p class="mt-2 text-pretty text-fg-muted">{item.text}</p>
							{item.link && (
								<p class="mt-auto pt-5">
									<Button href={item.link.href} variant="link">
										{item.link.label}
										<Icon name="freccia-destra" size="sm" />
									</Button>
								</p>
							)}
						</div>
					</li>
				))}
			</ul>
		)
	}
</Section>
