---
/**
 * Effetto di sfondo di una sezione (campo background della ricetta, src/themes/backgrounds.css).
 * Il blocco non lo riceve: questo wrapper senza box (display: contents) porta data-background e il
 * CSS dipinge l'effetto sulla radice <Section> del blocco, sopra il colore del tono. Con "pieno",
 * il valore di partenza, niente wrapper: l'HTML resta quello di sempre.
 */
import type { Background } from '@/themes/backgrounds';

interface Props {
	background?: Background;
}

const { background = 'pieno' } = Astro.props;
---

{
	background === 'pieno' ? (
		<slot />
	) : (
		<div data-background={background} class="contents">
			<slot />
		</div>
	)
}
