---
/**
 * Disegna le sezioni di una ricetta: per ogni sezione prende dal registry il componente del
 * suo type e gli passa tutto il resto (props del blocco, id, tone). Effetto di sfondo
 * (background) e bordo in alto (edge) non arrivano al blocco: li mette SectionFrame attorno alla
 * sezione. I dati arrivano già validati dalla collezione "pages", con le immagini già risolte.
 */
import type { Background } from '@/themes/backgrounds';
import type { Edge } from '@/themes/edges';
import type { SectionData } from './page-schema';
import { blocksByType } from './registry';
import SectionFrame from './SectionFrame.astro';

interface Props {
	sections: SectionData[];
}

const { sections } = Astro.props;
---

{
	sections.map(({ type, background, edge, ...props }, index) => {
		const block = blocksByType.get(String(type));
		if (!block) throw new Error(`Sezione di tipo "${type}": nessun blocco src/blocks/${type}/`);
		const { Component } = block;
		// Già validati dallo schema della pagina. La prima sezione non ha nulla sopra da coprire: niente bordo.
		return (
			<SectionFrame background={background as Background | undefined} edge={index === 0 ? undefined : (edge as Edge | undefined)}>
				<Component {...props} />
			</SectionFrame>
		);
	})
}
