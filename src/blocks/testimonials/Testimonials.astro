---
import CarouselTrack from '@/core/ui/Carousel.astro';
import CarouselSlide from '@/core/ui/CarouselSlide.astro';
import Icon from '@/core/ui/Icon.astro';
import Section from '@/core/ui/Section.astro';
import type { TestimonialsProps } from './schema';

type Props = TestimonialsProps;

const { id, tone, variant, eyebrow, title, items } = Astro.props;

const centered = variant !== 'cards';
const columns = items.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';
---

<Section id={id} tone={tone}>
	<div class:list={['max-w-2xl', centered && 'mx-auto text-center']}>
		{eyebrow && <p class="mb-4 text-sm font-semibold tracking-wider text-primary uppercase">{eyebrow}</p>}
		<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h2>
	</div>

	{
		variant === 'cards' && (
			<ul class={`mt-10 grid gap-6 ${columns}`}>
				{items.map((item) => (
					<li class="flex">
						<figure class="flex w-full flex-col rounded-box bg-surface p-6 text-surface-fg">
							<Icon name="citazione" size="lg" class="text-primary" />
							{item.rating && (
								<p class="mt-3 flex gap-0.5 text-primary" role="img" aria-label={`${item.rating} stelle su 5`}>
									{Array.from({ length: item.rating }, () => <Icon name="stella" size="sm" class="fill-current" />)}
								</p>
							)}
							<blockquote class="mt-3 text-pretty">
								<p>{item.quote}</p>
							</blockquote>
							<figcaption class="mt-auto pt-6 text-sm">
								<span class="block font-semibold">{item.author}</span>
								{item.role && <span class="block text-fg-muted">{item.role}</span>}
								<span class="block text-fg-muted">
									Fonte: {item.href ? <a href={item.href} rel="noopener" class="underline underline-offset-4">{item.fonte}</a> : item.fonte}
								</span>
							</figcaption>
						</figure>
					</li>
				))}
			</ul>
		)
	}

	{
		variant === 'singola' && (
			<figure class="mx-auto mt-10 max-w-3xl text-center">
				<Icon name="citazione" size="lg" class="mx-auto text-primary" />
				{items[0].rating && (
					<p class="mt-4 flex justify-center gap-0.5 text-primary" role="img" aria-label={`${items[0].rating} stelle su 5`}>
						{Array.from({ length: items[0].rating }, () => <Icon name="stella" size="md" class="fill-current" />)}
					</p>
				)}
				<blockquote class="mt-4 font-heading text-2xl font-bold tracking-tight text-balance sm:text-3xl">
					<p>{items[0].quote}</p>
				</blockquote>
				<figcaption class="mt-6">
					<span class="block font-semibold">{items[0].author}</span>
					{items[0].role && <span class="block text-fg-muted">{items[0].role}</span>}
					<span class="block text-sm text-fg-muted">
						Fonte:{' '}
						{items[0].href ? <a href={items[0].href} rel="noopener" class="underline underline-offset-4">{items[0].fonte}</a> : items[0].fonte}
					</span>
				</figcaption>
			</figure>
		)
	}

	{
		variant === 'slider' && (
			<CarouselTrack label={title} class="mx-auto mt-10 max-w-3xl">
				{items.map((item) => (
					<CarouselSlide width="full">
						<figure class="px-2 text-center sm:px-8">
							<Icon name="citazione" size="lg" class="mx-auto text-primary" />
							{item.rating && (
								<p class="mt-4 flex justify-center gap-0.5 text-primary" role="img" aria-label={`${item.rating} stelle su 5`}>
									{Array.from({ length: item.rating }, () => <Icon name="stella" size="sm" class="fill-current" />)}
								</p>
							)}
							<blockquote class="mt-4 text-xl text-balance sm:text-2xl">
								<p>{item.quote}</p>
							</blockquote>
							<figcaption class="mt-6 text-sm">
								<span class="block font-semibold">{item.author}</span>
								{item.role && <span class="block text-fg-muted">{item.role}</span>}
								<span class="block text-fg-muted">
									Fonte: {item.href ? <a href={item.href} rel="noopener" class="underline underline-offset-4">{item.fonte}</a> : item.fonte}
								</span>
							</figcaption>
						</figure>
					</CarouselSlide>
				))}
			</CarouselTrack>
		)
	}
</Section>
