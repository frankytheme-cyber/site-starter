---
import { icons, type IconName } from '@/core/icons';
import Button from '@/core/ui/Button.astro';
import Container from '@/core/ui/Container.astro';
import Icon from '@/core/ui/Icon.astro';
import CatalogLayout from './_CatalogLayout.astro';

const entries = Object.entries(icons) as [IconName, string][];
const groups = [
	{ title: 'Simboli', source: 'Lucide', set: 'lucide' },
	{ title: 'Marchi', source: 'Simple Icons', set: 'simple-icons' },
].map((group) => ({ ...group, icons: entries.filter(([, id]) => id.startsWith(`${group.set}:`)) }));

const sizes = ['sm', 'md', 'lg'] as const;
---

<CatalogLayout title="Icone · Catalogo blocchi">
	<main>
		<Container>
			<div class="py-10">
				<h1 class="text-3xl font-bold">Icone</h1>
				<p class="mt-3 max-w-3xl text-fg-muted">
					{entries.length} icone ammesse, definite in <code>src/core/icons.ts</code>. Nei componenti:{' '}
					<code>&lt;Icon name="pennello" /&gt;</code>; negli schemi dei blocchi: <code>z.enum(ICON_NAMES)</code>. Il
					colore è quello del testo intorno.
				</p>

				{
					groups.map((group) => (
						<section class="mt-10">
							<h2 class="text-xl font-bold">
								{group.title} <span class="text-base font-normal text-fg-muted">· {group.source}</span>
							</h2>
							{group.set === 'simple-icons' && (
								<p class="mt-1 text-sm text-fg-muted">
									Solo per i link ai profili dell’attività: sono marchi registrati dei rispettivi titolari.
								</p>
							)}
							<ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
								{group.icons.map(([name, id]) => (
									<li class="flex flex-col items-center gap-3 rounded-box border border-border px-2 py-5 text-center">
										<Icon name={name} size="lg" />
										<span>
											<code class="block font-semibold">{name}</code>
											<span class="block text-xs text-fg-muted">{id.split(':')[1]}</span>
										</span>
									</li>
								))}
							</ul>
						</section>
					))
				}

				<section class="mt-12">
					<h2 class="text-xl font-bold">Dimensioni</h2>
					<ul class="mt-4 flex flex-wrap items-end gap-8">
						{
							sizes.map((size) => (
								<li class="flex flex-col items-center gap-2">
									<Icon name="rullo" size={size} />
									<code class="text-sm">{size}</code>
								</li>
							))
						}
					</ul>
				</section>

				<section class="mt-12">
					<h2 class="text-xl font-bold">Nei pulsanti</h2>
					<p class="mt-1 text-sm text-fg-muted">
						Dentro <code>Button</code> l’icona va nello slot, prima o dopo il testo.
					</p>
					<div class="mt-4 flex flex-wrap items-center gap-4">
						<Button href="#">
							Chiedi un preventivo
							<Icon name="freccia-destra" />
						</Button>
						<Button href="#" variant="secondary">
							<Icon name="telefono" />
							Chiama
						</Button>
						<Button href="#" variant="link">
							<Icon name="whatsapp" />
							Scrivici su WhatsApp
						</Button>
					</div>
				</section>

				<section class="mt-12">
					<h2 class="text-xl font-bold">Solo icona</h2>
					<p class="mt-1 text-sm text-fg-muted">
						Se l’icona è l’unico contenuto di un link, <code>label</code> ne diventa il nome accessibile.
					</p>
					<ul class="mt-4 flex gap-2">
						{
							(
								[
									['facebook', 'Facebook'],
									['instagram', 'Instagram'],
									['whatsapp', 'WhatsApp'],
								] as const
							).map(([name, label]) => (
								<li>
									<a href="#" class="inline-flex size-11 items-center justify-center rounded-button text-primary">
										<Icon name={name} size="lg" label={label} />
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>
		</Container>
	</main>
</CatalogLayout>
