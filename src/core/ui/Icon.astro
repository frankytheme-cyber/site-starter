---
/**
 * Icona SVG inline dalla lista chiusa di core/icons.ts. Il colore è sempre currentColor:
 * prende quello del testo intorno (text-primary sul contenitore per colorarla).
 */
import { Icon as Iconify } from 'astro-icon/components';
import { icons, type IconName } from '@/core/icons';

interface Props {
	name: IconName;
	/** sm 16px (nel testo) · md 20px (pulsanti, liste) · lg 24px (card, elenchi di servizi). */
	size?: 'sm' | 'md' | 'lg';
	/**
	 * Senza label l'icona è decorativa e nascosta agli screen reader. Serve quando l'icona
	 * porta un'informazione che non è già nel testo, es. è l'unico contenuto di un link.
	 */
	label?: string;
	class?: string;
}

const { name, size = 'md', label, class: className } = Astro.props;

const sizes = { sm: 'size-4', md: 'size-5', lg: 'size-6' };
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

{/* is:inline: SVG completo a ogni uso, senza <use> verso un simbolo definito altrove nella pagina. */}
<Iconify name={icons[name]} is:inline class:list={['shrink-0', sizes[size], className]} {...a11y} />
