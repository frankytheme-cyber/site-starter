---
/** Una voce di Accordion: titolo nel <summary>, contenuto nello slot. */
import Icon from './Icon.astro';

interface Props {
	title: string;
	/** Aperta al caricamento. */
	open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details data-accordion-item class="group" open={open}>
	<summary
		class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold [&::-webkit-details-marker]:hidden"
	>
		<span>{title}</span>
		<Icon name="chevron-giu" class="group-open:rotate-180 motion-safe:transition-transform" />
	</summary>
	<div data-accordion-content class="pb-5">
		<slot />
	</div>
</details>
