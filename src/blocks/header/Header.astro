---
import { nextId } from '@/core/ids';
import { assertSpecialHrefs, resolveHref } from '@/core/links';
import { getNavigation, isCurrentPage } from '@/core/navigation';
import { getSiteSettings, phoneHref } from '@/core/settings';
import CtaButton from '@/core/ui/button/CtaButton.astro';
import Icon from '@/core/ui/Icon.astro';
import Img from '@/core/ui/Img.astro';
import Section from '@/core/ui/Section.astro';
import type { HeaderProps } from './schema';

type Props = HeaderProps;

const { id, tone, variant, sticky } = Astro.props;

// Nome, logo, telefono e menu arrivano da site.json e navigation.json: lo schema del blocco non li contiene.
const [site, navigation] = await Promise.all([getSiteSettings(), getNavigation()]);
const logo = Astro.props.logo ?? (site.logo ? 'immagine' : 'testo');

if (logo === 'immagine' && !site.logo) {
	throw new Error('Header con logo "immagine": manca "logo" in src/content/settings/site.json');
}
if (variant === 'con-cta' && !navigation.cta) {
	throw new Error('Header "con-cta": manca "cta" in src/content/settings/navigation.json');
}
assertSpecialHrefs('impostazioni navigation.json', navigation, site);
const cta = variant === 'con-cta' ? navigation.cta : undefined;
// Il fallback senza JS usa un <a> semplice: il link speciale (@telefono...) va risolto qui.
const ctaHref = cta && (await resolveHref(cta.href));

const uid = nextId(Astro.request, 'header');
const menuId = `${uid}-menu`;
const pathname = Astro.url.pathname;

const items = navigation.items.map((item, index) => ({
	label: item.label,
	href: item.href,
	current: isCurrentPage(item.href, pathname),
	// La voce madre resta evidenziata anche quando la pagina aperta è una delle sue figlie.
	inBranch: item.children?.some((child) => isCurrentPage(child.href, pathname)) ?? false,
	submenuId: `${uid}-sub-${index + 1}`,
	children: item.children?.map((child) => ({ ...child, current: isCurrentPage(child.href, pathname) })),
}));

const ariaCurrent = (current: boolean) => (current ? 'page' : undefined);
const linkClass =
	'decoration-2 underline-offset-8 hover:underline aria-[current=page]:text-primary aria-[current=page]:underline';
---

{
	sticky && (
		/* Sentinella fuori dall'header: quando i suoi 80px escono dallo schermo, lo script compatta l'header. */
		<div class="relative h-0" aria-hidden="true">
			<div data-header-sentinel class="pointer-events-none absolute top-0 left-0 h-20 w-px" />
		</div>
	)
}

<Section
	id={id}
	tone={tone}
	as="header"
	flush
	sticky={sticky}
	class="group/header z-40 border-b border-border has-[[data-open]]:z-41 motion-safe:transition-shadow [&.is-compact]:shadow-md"
	data-header
	data-sticky={sticky ? '' : undefined}
>
	<div
		class="flex items-center gap-4 py-4 group-[.is-compact]/header:py-2 motion-safe:transition-[padding] motion-safe:duration-200 lg:gap-8"
	>
		<a href="/" class="mr-auto flex min-h-11 shrink-0 items-center">
			{
				logo === 'immagine' && site.logo ? (
					<Img
						src={site.logo}
						alt={site.businessName}
						sizes="200px"
						class="h-10 w-auto group-[.is-compact]/header:h-8 motion-safe:transition-[height] motion-safe:duration-200"
					/>
				) : (
					<span class="font-heading text-xl font-bold tracking-tight">{site.businessName}</span>
				)
			}
		</a>

		<nav aria-label="Principale" class="hidden lg:block">
			<ul class="flex items-center gap-1">
				{
					items.map((item) =>
						item.children ? (
							<li data-header-item class="group/item relative flex items-center">
								<a
									href={item.href}
									aria-current={ariaCurrent(item.current)}
									class:list={['flex min-h-11 items-center pl-3 font-semibold', linkClass, item.inBranch && 'text-primary']}
								>
									{item.label}
								</a>
								<button
									type="button"
									hidden
									data-js-only
									data-header-toggle
									aria-expanded="false"
									aria-controls={item.submenuId}
									class="flex size-11 items-center justify-center rounded-button"
								>
									<span class="sr-only">Sottomenu {item.label}</span>
									<Icon
										name="chevron-giu"
										size="sm"
										class="group-data-[open]/item:rotate-180 motion-safe:transition-transform"
									/>
								</button>
								<ul
									id={item.submenuId}
									data-header-submenu
									class="absolute top-full left-0 min-w-56 rounded-box border border-border bg-bg p-2 shadow-lg"
								>
									{item.children.map((child) => (
										<li>
											<a
												href={child.href}
												aria-current={ariaCurrent(child.current)}
												class:list={['flex min-h-11 items-center px-3', linkClass]}
											>
												{child.label}
											</a>
										</li>
									))}
								</ul>
							</li>
						) : (
							<li>
								<a
									href={item.href}
									aria-current={ariaCurrent(item.current)}
									class:list={['flex min-h-11 items-center px-3 font-semibold', linkClass]}
								>
									{item.label}
								</a>
							</li>
						),
					)
				}
			</ul>
		</nav>

		{
			cta ? (
				<div class="hidden lg:block">
					<CtaButton cta={cta} tone={tone} />
				</div>
			) : (
				<a
					href={phoneHref(site.phone)}
					class="hidden min-h-11 items-center gap-2 font-semibold decoration-2 underline-offset-8 hover:underline lg:flex"
				>
					<Icon name="telefono" />
					<span class="sr-only">Chiama</span>
					{site.phone}
				</a>
			)
		}

		<div class="-mr-2 flex items-center lg:hidden">
			<a href={phoneHref(site.phone)} class="flex size-11 items-center justify-center rounded-button">
				<Icon name="telefono" size="lg" label={`Chiama ${site.phone}`} />
			</a>
			<button
				type="button"
				hidden
				data-js-only
				data-header-open
				aria-expanded="false"
				aria-controls={menuId}
				class="flex size-11 items-center justify-center rounded-button"
			>
				<Icon name="menu" size="lg" label="Apri il menu" />
			</button>
		</div>
	</div>

	{/* Senza JS il pulsante del menu resta nascosto: le voci si mostrano qui, sotto la barra. */}
	<noscript>
		<nav aria-label="Principale" class="pb-4 lg:hidden">
			<ul class="flex flex-wrap gap-x-5">
				{
					items
						.flatMap((item) => [item, ...(item.children ?? [])])
						.map((link) => (
							<li>
								<a
									href={link.href}
									aria-current={ariaCurrent(link.current)}
									class="flex min-h-11 items-center font-semibold underline underline-offset-4"
								>
									{link.label}
								</a>
							</li>
						))
				}
				{
					cta && (
						<li>
							<a href={ctaHref} class="flex min-h-11 items-center font-semibold text-primary underline underline-offset-4">
								{cta.label}
							</a>
						</li>
					)
				}
			</ul>
		</nav>
	</noscript>

	<dialog
		id={menuId}
		data-header-menu
		aria-label="Menu"
		class="m-0 ml-auto h-dvh max-h-none w-11/12 max-w-sm border-0 bg-bg p-0 text-fg backdrop:bg-black/50"
	>
		{/* Il contenuto copre tutto il dialog: un click sul dialog stesso è un click sul fondo. */}
		<div class="flex min-h-full flex-col p-6">
			<div class="flex items-center justify-between gap-4">
				<span class="font-heading text-lg font-bold">{site.businessName}</span>
				<button type="button" data-header-close class="-mr-2 flex size-11 items-center justify-center rounded-button">
					<Icon name="chiudi" size="lg" label="Chiudi il menu" />
				</button>
			</div>
			<nav aria-label="Principale" class="mt-6">
				<ul class="grid gap-1">
					{
						items.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={ariaCurrent(item.current)}
									class:list={['flex min-h-11 items-center text-lg font-semibold', linkClass, item.inBranch && 'text-primary']}
								>
									{item.label}
								</a>
								{item.children && (
									<ul class="mb-2 ml-1 border-l-2 border-border pl-4">
										{item.children.map((child) => (
											<li>
												<a
													href={child.href}
													aria-current={ariaCurrent(child.current)}
													class:list={['flex min-h-11 items-center', linkClass]}
												>
													{child.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</li>
						))
					}
				</ul>
			</nav>
			{
				cta && (
					<div class="mt-auto grid pt-8">
						<CtaButton cta={cta} tone={tone} />
					</div>
				)
			}
		</div>
	</dialog>
</Section>

<style is:global>
	/* Sottomenu: chiusi di norma; senza JS si aprono al passaggio del mouse e col focus da tastiera. */
	[data-header-submenu] {
		display: none;
	}
	[data-header]:not([data-js]) [data-header-item]:is(:hover, :focus-within) > [data-header-submenu],
	[data-header-item][data-open] > [data-header-submenu] {
		display: block;
	}

	/* Menu mobile: entra da destra, senza animazione per chi chiede movimento ridotto. */
	@media (prefers-reduced-motion: no-preference) {
		[data-header-menu][open] {
			animation: header-menu-in 200ms ease-out;
		}
		[data-header-menu][open]::backdrop {
			animation: header-backdrop-in 200ms ease-out;
		}
	}
	@keyframes header-menu-in {
		from {
			transform: translateX(100%);
		}
	}
	@keyframes header-backdrop-in {
		from {
			opacity: 0;
		}
	}
</style>

<script>
	// Uno script per tutti gli header della pagina. Regole: docs/blocchi-interattivi.md.
	const desktop = window.matchMedia('(min-width: 64rem)');

	for (const header of document.querySelectorAll<HTMLElement>('[data-header]')) {
		header.dataset.js = '';
		for (const element of header.querySelectorAll<HTMLElement>('[data-js-only]')) element.hidden = false;
		initSubmenus(header);
		initMenu(header);
		if (header.dataset.sticky !== undefined) initCompact(header);
	}

	/** Sottomenu desktop: aperti da click, Invio o Spazio sul pulsante; Esc, Tab fuori o click fuori li chiudono. */
	function initSubmenus(header: HTMLElement) {
		const items = [...header.querySelectorAll<HTMLElement>('[data-header-item]')];
		const toggleOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('[data-header-toggle]')!;
		const setOpen = (item: HTMLElement, open: boolean) => {
			item.toggleAttribute('data-open', open);
			toggleOf(item).setAttribute('aria-expanded', String(open));
		};

		for (const item of items) {
			const toggle = toggleOf(item);
			toggle.addEventListener('click', () => {
				const open = !item.hasAttribute('data-open');
				for (const other of items) if (other !== item) setOpen(other, false);
				setOpen(item, open);
			});
			item.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && item.hasAttribute('data-open')) {
					setOpen(item, false);
					toggle.focus();
				}
			});
			// relatedTarget nullo (click su un'area vuota) non chiude: ci pensa il click fuori.
			item.addEventListener('focusout', (event) => {
				const next = event.relatedTarget;
				if (next instanceof Node && !item.contains(next)) setOpen(item, false);
			});
		}

		document.addEventListener('click', (event) => {
			for (const item of items) if (!item.contains(event.target as Node)) setOpen(item, false);
		});
	}

	/** Menu mobile in un <dialog> modale: focus intrappolato e Esc gestiti dal browser. */
	function initMenu(header: HTMLElement) {
		const opener = header.querySelector<HTMLButtonElement>('[data-header-open]');
		const dialog = header.querySelector<HTMLDialogElement>('[data-header-menu]');
		if (!opener || !dialog) return;
		const page = document.documentElement;

		opener.addEventListener('click', () => {
			dialog.showModal();
			opener.setAttribute('aria-expanded', 'true');
			page.classList.add('overflow-hidden');
		});

		// "close" arriva da ogni chiusura: Esc, pulsante, fondo, voce, passaggio a desktop.
		dialog.addEventListener('close', () => {
			opener.setAttribute('aria-expanded', 'false');
			page.classList.remove('overflow-hidden');
			opener.focus();
		});

		dialog.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (target === dialog || target.closest('a, [data-header-close]')) dialog.close();
		});

		desktop.addEventListener('change', (event) => {
			if (event.matches && dialog.open) dialog.close();
		});
	}

	/** Header sticky: si compatta quando la sentinella (80px) è uscita dall'alto. Nessun listener di scroll. */
	function initCompact(header: HTMLElement) {
		const sentinel = header.previousElementSibling?.querySelector('[data-header-sentinel]');
		if (!sentinel) return;
		// Se la pagina aggancia l'header sotto un'altra barra (--sticky-offset), il bordo da superare scende con lui.
		const offset = parseFloat(getComputedStyle(header).top) || 0;

		new IntersectionObserver(
			([entry]) => {
				const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.bottom <= offset;
				header.classList.toggle('is-compact', scrolledPast);
			},
			{ rootMargin: `${-offset}px 0px 0px 0px` },
		).observe(sentinel);
	}
</script>
