---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { resolveImage } from '@/core/images';

interface Props {
	/** Immagine importata, oppure percorso relativo a src/assets/images (es. "fixtures/foto.jpg"). */
	src: ImageMetadata | string;
	/** Obbligatorio. Stringa vuota solo per immagini puramente decorative. */
	alt: string;
	/** constrained: non supera la larghezza originale · full-width: riempie sempre il contenitore. */
	layout?: 'constrained' | 'full-width';
	sizes?: string;
	/** Per l'immagine principale above the fold (es. hero): caricata subito, con priorità alta. */
	priority?: boolean;
	class?: string;
}

const { src, alt, layout = 'constrained', sizes, priority = false, class: className } = Astro.props;
const image = typeof src === 'string' ? resolveImage(src) : src;
---

<Image src={image} alt={alt} layout={layout} sizes={sizes} priority={priority} class={className} />
