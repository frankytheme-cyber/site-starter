---
import CarouselTrack from '@/core/ui/Carousel.astro';
import CarouselSlide from '@/core/ui/CarouselSlide.astro';
import CtaButton from '@/core/ui/button/CtaButton.astro';
import Img from '@/core/ui/Img.astro';
import Section from '@/core/ui/Section.astro';
import type { CarouselProps } from './schema';

type Props = CarouselProps;

const { id, tone, variant, eyebrow, title, intro, items } = Astro.props;

const isCard = variant === 'immagini-testo';
// Larghezze delle slide (CarouselSlide): foto quasi a tutta riga, due da md; card fino a tre da lg.
const sizes = isCard
	? '(min-width: 1152px) 352px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 85vw'
	: '(min-width: 1152px) 536px, (min-width: 768px) 47vw, 88vw';
---

<Section id={id} tone={tone}>
	<div class="max-w-2xl">
		{eyebrow && <p class="mb-4 text-sm font-semibold tracking-wider text-primary uppercase">{eyebrow}</p>}
		<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h2>
		{intro && <p class="mt-4 text-lg text-pretty text-fg-muted">{intro}</p>}
	</div>

	<CarouselTrack label={title} class="mt-10">
		{
			items.map((item) =>
				isCard ? (
					<CarouselSlide width="card">
						<article class="flex h-full flex-col overflow-hidden rounded-box bg-surface text-surface-fg">
							<Img src={item.image.src} alt={item.image.alt} sizes={sizes} class="aspect-3/2 w-full object-cover" />
							<div class="flex flex-1 flex-col p-6">
								<h3 class="text-xl font-bold tracking-tight">{item.title}</h3>
								<p class="mt-2 text-pretty text-fg-muted">{item.text}</p>
								{item.cta && (
									<p class="mt-auto pt-5">
										<CtaButton cta={{ icon: 'freccia-destra', ...item.cta }} defaultStyle="link" tone={tone} />
									</p>
								)}
							</div>
						</article>
					</CarouselSlide>
				) : (
					<CarouselSlide width="wide">
						<figure>
							<Img src={item.image.src} alt={item.image.alt} sizes={sizes} class="aspect-4/3 w-full rounded-box object-cover" />
							{item.title && <figcaption class="mt-3 text-sm text-fg-muted">{item.title}</figcaption>}
						</figure>
					</CarouselSlide>
				),
			)
		}
	</CarouselTrack>
</Section>
