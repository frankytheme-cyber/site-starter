{
  "version": "0.0.4",
  "repository": "https://github.com/frankytheme-cyber/site-starter.git",
  "managed": ["src/blocks", "src/core", "src/themes", "src/layouts", "scripts", ".agents/skills", ".claude/skills", "docs/catalogo", "docs/skill", "docs/modelli", "docs/agenti", "docs/paperclip-runtime", ".github/workflows"],
  "managedFiles": [
    "api/contact.ts",
    ".env.example",
    ".github/CODEOWNERS",
    "AGENTS.md",
    "CLAUDE.md",
    "astro.config.mjs",
    "docs/THIRD_PARTY_LICENSES.md",
    "docs/blocchi-interattivi.md",
    "docs/controlli.md",
    "docs/decap.md",
    "docs/form.md",
    "docs/provisioning.md",
    "docs/paperclip.md",
    "docs/github-ruleset-sito.json",
    "docs/siti-cliente.md",
    "docs/specifica.md",
    "library.manifest.json",
    "public/admin/index.html",
    "src/content.config.ts",
    "src/pages/[...slug].astro",
    "src/pages/robots.txt.ts",
    "tsconfig.json"
  ],
  "exclude": ["src/library"],
  "libraryOnly": ["src/library", "docs/README.md", "CHANGELOG.md"],
  "libraryScripts": ["site:init", "site:create", "test:provisioning", "check:template", "gen:catalog", "screenshots", "catalog", "release"]
}
