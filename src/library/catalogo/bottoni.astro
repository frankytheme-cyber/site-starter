---
/**
 * Bottoni (core/ui/button): ogni variante in ogni stato, misura e tono, con e senza icona.
 * Gli stati sono forzati con data-state, che esiste solo qui: button.css li disegna come quelli veri.
 * Le righe «normale» restano interattive: hover, Tab e click mostrano gli stati reali.
 */
import { TONES } from '@/core/block-types';
import Button from '@/core/ui/button/Button.astro';
import { BUTTON_STYLES, SPECIAL_HREFS } from '@/core/ui/button/cta';
import Container from '@/core/ui/Container.astro';
import Section from '@/core/ui/Section.astro';
import CatalogLayout from './_CatalogLayout.astro';

const STATES = [
	{ label: 'normale', state: undefined },
	{ label: 'hover', state: 'hover' },
	{ label: 'focus', state: 'focus' },
	{ label: 'active', state: 'active' },
	{ label: 'disabled', state: 'disabled' },
] as const;
const SIZES = ['sm', 'md', 'lg'] as const;
const COLUMNS = SIZES.flatMap((size) => [
	{ size, icon: false },
	{ size, icon: true },
]);
---

<CatalogLayout title="Bottoni · Catalogo blocchi">
	<main id="bottoni">
		<Container>
			<div class="py-10">
				<h1 class="text-3xl font-bold">Bottoni</h1>
				<p class="mt-3 max-w-3xl text-fg-muted">
					<code>Button</code> e <code>CtaButton</code> di <code>src/core/ui/button</code>: varianti
					<code>{BUTTON_STYLES.join(', ')}</code>, misure <code>{SIZES.join(', ')}</code>, su ogni tono. Gli stati
					delle righe hover, focus, active e disabled sono forzati con <code>data-state</code>, solo in questa pagina; la
					riga «normale» risponde davvero a mouse, Tab e click. Stili in <code>button.css</code>, contrasti verificati da
					<code>npm run check:contrast</code>.
				</p>
			</div>
		</Container>

		{
			TONES.map((tone) => (
				<Section tone={tone}>
					<h2 class="text-2xl font-bold">
						Tone <code>{tone}</code>
					</h2>
					{BUTTON_STYLES.map((variant) => (
						<div class="mt-8 overflow-x-auto">
							<table class="text-left text-sm">
								<caption class="mb-2 text-left text-base font-semibold">
									<code>{variant}</code>
									<span class="font-normal text-fg-muted"> · tone {tone}</span>
								</caption>
								<thead>
									<tr>
										<th scope="col" class="pr-4 font-normal text-fg-muted">
											Stato
										</th>
										{COLUMNS.map(({ size, icon }) => (
											<th scope="col" class="px-2 pb-2 font-normal whitespace-nowrap text-fg-muted">
												{size}
												{icon && ' + icona'}
											</th>
										))}
									</tr>
								</thead>
								<tbody>
									{STATES.map(({ label, state }) => (
										<tr>
											<th scope="row" class="pr-4 font-normal">
												<code>{label}</code>
											</th>
											{COLUMNS.map(({ size, icon }) => (
												<td class="p-2">
													<Button
														href="#bottoni"
														variant={variant}
														size={size}
														icon={icon ? 'freccia-destra' : undefined}
														iconPosition="end"
														tone={tone}
														disabled={state === 'disabled'}
														data-state={state}
														class="whitespace-nowrap"
													>
														Preventivo
													</Button>
												</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					))}
				</Section>
			))
		}

		<Section tone="default">
			<h2 class="text-2xl font-bold">Link speciali ed esterni</h2>
			<p class="mt-2 max-w-3xl text-fg-muted">
				<code>{SPECIAL_HREFS.join(', ')}</code> diventano tel:, wa.me, mailto: e Google Maps con i dati di site.json. I link
				esterni si aprono in una nuova scheda con rel="noopener".
			</p>
			<div class="mt-6 flex flex-wrap items-center gap-4">
				<Button href="@telefono" icon="telefono">Chiama</Button>
				<Button href="@whatsapp" icon="whatsapp" variant="secondary">WhatsApp</Button>
				<Button href="@email" icon="email" variant="ghost">Email</Button>
				<Button href="@mappa" icon="mappa-pin" variant="link">Come arrivare</Button>
				<Button href="https://example.com/" variant="link" icon="freccia-destra" iconPosition="end">Sito esterno</Button>
			</div>

			<h3 class="mt-12 text-xl font-bold">Prop tone fuori da una Section primary</h3>
			<div class="mt-4 flex flex-wrap gap-4 rounded-box bg-primary p-6 text-primary-fg">
				{BUTTON_STYLES.map((variant) => (
					<Button href="#bottoni" variant={variant} tone="primary">
						{variant}
					</Button>
				))}
			</div>
		</Section>
	</main>
</CatalogLayout>
