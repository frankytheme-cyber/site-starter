---
/**
 * Pulsante o link d'azione. Con href è un <a>, altrimenti un <button>.
 * href accetta anche @telefono, @whatsapp, @email, @mappa (risolti da site.json, core/links.ts);
 * i link esterni si aprono in una nuova scheda con rel="noopener".
 *
 * Tono: dentro una Section i token si adattano già al suo data-tone (base.css), quindi su
 * tone primary il pulsante pieno diventa chiaro da solo. La prop tone serve a dichiararlo quando il
 * pulsante sta su un fondo primary fuori da una Section primary.
 */
import type { Tone } from '@/core/block-types';
import type { IconName } from '@/core/icons';
import { isExternal, resolveHref } from '@/core/links';
import type { ButtonStyle } from '@/core/schemas/cta';
import Icon from './Icon.astro';

interface Props {
	href?: string;
	/** primary: pieno · secondary: bordo nel colore del testo · ghost: solo testo, sfondo al passaggio · link: sottolineato. */
	variant?: ButtonStyle;
	size?: 'sm' | 'md' | 'lg';
	icon?: IconName;
	iconPosition?: 'start' | 'end';
	tone?: Tone;
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	class?: string;
	[attribute: `data-${string}` | `aria-${string}`]: string | boolean | undefined;
}

const {
	href,
	variant = 'primary',
	size = 'md',
	icon,
	iconPosition = 'start',
	tone,
	type = 'button',
	disabled = false,
	class: className,
	...attributes
} = Astro.props;

const url = href ? await resolveHref(href) : undefined;
const external = url ? isExternal(url, Astro.site) : false;

const isLink = variant === 'link';
const sizes = isLink
	? { sm: 'text-sm', md: 'text-base', lg: 'text-lg' }
	: { sm: 'min-h-9 px-4 py-1.5 text-sm', md: 'min-h-11 px-6 py-2.5 text-base', lg: 'min-h-13 px-8 py-3 text-lg' };

// L'hover sottolinea o scurisce di poco lo sfondo: il contrasto resta quello verificato.
// Il focus è un anello con stacco nel colore di sfondo, visibile su ogni tono e sulle foto.
const classes = [
	'inline-flex items-center justify-center gap-2 font-semibold decoration-2 underline-offset-4',
	'focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg',
	'disabled:cursor-not-allowed disabled:opacity-60',
	sizes[size],
	{
		primary: 'rounded-button bg-primary text-primary-fg hover:underline',
		secondary: 'rounded-button border-2 border-current hover:underline',
		ghost: 'rounded-button hover:bg-current/10',
		link: 'text-primary underline hover:decoration-transparent',
	}[variant],
	className,
];
const iconSize = size === 'sm' ? 'sm' : 'md';
const onTone = tone === 'primary' ? 'primary' : undefined;
---

{
	url ? (
		<a
			href={url}
			class:list={classes}
			data-on-tone={onTone}
			target={external ? '_blank' : undefined}
			rel={external ? 'noopener' : undefined}
			{...attributes}
		>
			{icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />}
			<slot />
			{external && <span class="sr-only">(si apre in una nuova scheda)</span>}
			{icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
		</a>
	) : (
		<button type={type} disabled={disabled} class:list={classes} data-on-tone={onTone} {...attributes}>
			{icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />}
			<slot />
			{icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
		</button>
	)
}
