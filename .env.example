# Variabili per lo sviluppo in locale: copia questo file in .env (che non va nel repository).
# In CI e su Vercel le stesse variabili si impostano nelle impostazioni del progetto: docs/siti-cliente.md.

# Modalità del progetto (src/core/mode.ts).
# 1 SOLO nella repo site-starter, la libreria: /catalogo, schede e screenshot, rilasci, segnaposto
# del template come avvisi. In un sito cliente lasciala vuota o toglila: è il default sicuro.
SITE_STARTER_LIBRARY=

# Repository GitHub (org/nome) in cui il CMS salva le modifiche. Di solito non serve: lo scrive
# npm run site:init in src/site.config.ts, altrimenti si ricava dal remote "origin".
# DECAP_REPO=
